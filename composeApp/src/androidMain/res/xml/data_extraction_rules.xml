<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The API key file is excluded because the Keystore key that decrypts it never
     leaves the device, so a restored copy cannot be read and crashes the app. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="api_key_storage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="api_key_storage.xml" />
    </device-transfer>
</data-extraction-rules>
